# AEM Connection
# Universal Editor uses APP_HOST_URI when not proxied (see AppComponent.installUniversalEditor).
APP_HOST_URI=https://author-p18253-e46622.adobeaemcloud.com
APP_PUBLISH_URI=https://publish-p18253-e46622.adobeaemcloud.com
APP_ENDPOINT=securbank
APP_GRAPHQL_ENDPOINT=/content/graphql/global/endpoint.json

# Authentication: basic | service-token | none
APP_AUTH_METHOD=basic
APP_BASIC_AUTH_USER=securbank
APP_BASIC_AUTH_PASS=your-password
APP_SERVICE_TOKEN=

# AEM Embed (optional - for header/footer from AEM Edge Delivery)
# URLs to AEM.live / Edge Delivery pages. When set, replaces default header/footer.
# On localhost, CORS for ES modules is avoided via /aem-embed-proxy/embed-example (see proxy.conf.js + index.html).
# APP_AEM_EMBED_HEADER_URL=https://main--embed-example--aemsites.aem.page/header
# APP_AEM_EMBED_FOOTER_URL=https://main--site--org.aem.page/

# Okta (for Sign In)
APP_OKTA_ISSUER=https://your-tenant.okta.com/oauth2/default
APP_OKTA_CLIENT_ID=your-client-id
APP_OKTA_REDIRECT_URI=https://your-app.vercel.app/login/callback
APP_OKTA_SCOPES=openid profile email

# Universal Editor (https://experience.adobe.com)
# - Run the app over HTTPS locally: npm run start:https
#   That mode is HTTPS-only on the port: use https://localhost:4200/ (and https://.../scripts/aem-embed.js).
#   Opening http:// on the same port talks to TLS with plain HTTP, so assets look "not loading."
# - Canvas URL must include the full app origin after .../canvas/ (with https://), e.g.:
#   https://experience.adobe.com/#/@YOUR_ORG/aem/editor/canvas/https://localhost:4200/?variation=master
#   (Using only "localhost:4200" without https:// often fails to load.)
# - AEM author must allow your app origin in Granite CORS (e.g. https://localhost:4200 and
#   https://experience.adobe.com) so the iframe and UE shell can call author APIs.
# - The app sets urn:adobe:aue:system:aemconnection to your real APP_HOST_URI (not "aem:/" on localhost),
#   so the UE menu rail / persistence resolve the correct author. If the rail still returns 500 with an
#   Adobe Request ID, treat it as a cloud/IMS/AEM support issue and share that ID with Adobe.
# - If the hosted UE service cannot reach your machine, use a tunnel (ngrok) or a local UE service (see Adobe local UE docs).

# Server
PORT=3001
